rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    // A missing `status` field reads as active, so accounts created before
    // this field existed keep working. Rules throw on a missing map key, so
    // the two-argument get() with a default is required here, not `.status`.
    function isActive() {
      return isSignedIn() && userDoc().get('status', 'active') != 'inactive';
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return isActive() && userRole() == 'admin';
    }

    // recruiter, hiring-manager and admin are the internal "staff" roles —
    // candidates never read/write these collections.
    function isStaff() {
      return isActive() && userRole() in ['admin', 'recruiter', 'hiring-manager'];
    }

    match /Users/{userId} {
      // A deactivated user must still be able to read their OWN document, so
      // the app can detect the deactivation and sign them out with a clear
      // message rather than an opaque permission error. Hence isSignedIn()
      // here, not isActive().
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      // Self-registration may only ever create a candidate. Staff accounts
      // come from an admin through User Management. isSignedIn() here, not
      // isActive(), because the document being created is the one isActive()
      // would need to read — it doesn't exist yet.
      allow create: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == userId
            && request.resource.data.role == 'candidate');
      allow update: if isAdmin()
        || (request.auth.uid == userId
            && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
    }

    match /Positions/{positionId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /Counters/{counterId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /Requisitions/{requisitionId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();

      match /approvals/{level} {
        allow read: if isStaff();
        allow create: if isStaff();
        allow update: if isActive() && request.auth.uid == resource.data.approverId;
      }
    }

    // Job adverts. The public (including signed-out visitors) may only see
    // live, external, non-confidential career-site adverts. Public queries
    // MUST filter on all four fields so list reads can be proven safe.
    match /Jobs/{jobId} {
      allow read: if isStaff()
        || (resource.data.status in ['Active', 'Re-advertised']
            && resource.data.showOnCareerSite == true
            && resource.data.isConfidential == false
            && resource.data.advertType == 'external');
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Applications: candidates create their own (with the mandatory
    // declaration), read their own, and can NEVER amend or delete them
    // after submission. Staff manage the pipeline.
    match /Applications/{applicationId} {
      allow read: if isStaff()
        || (isActive() && resource.data.candidateId == request.auth.uid);
      allow create: if isStaff()
        || (isActive()
            && request.resource.data.candidateId == request.auth.uid
            && request.resource.data.consentGiven == true
            && request.resource.data.status == 'applied');
      allow update: if isStaff();
      allow delete: if false;

      // Panel collaboration comments (shortlisting rationale, notes).
      match /comments/{commentId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }

      // Panel ratings (1 unsuitable, 2 fair, 3 suitable). The document id is the
      // panelist's uid, so a panelist can only ever write their own rating.
      match /ratings/{panelistId} {
        allow read: if isStaff();
        allow create, update: if isStaff()
          && request.auth.uid == panelistId
          && request.resource.data.panelistId == panelistId
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 3;
        allow delete: if isStaff() && request.auth.uid == panelistId;
      }
    }

    // Extended bio-data for shortlisted candidates: candidates may submit/update
    // only their own record (doc id == applicationId); staff read for review.
    match /BioData/{applicationId} {
      // `resource` is null when the document doesn't exist yet, and
      // `resource.data` on null throws rather than denying cleanly — which
      // the client sees as a permission error instead of "not found". The
      // `resource == null ||` short-circuits before that dereference, so a
      // candidate checking their own not-yet-submitted bio-data gets a clean
      // negative (snap.exists() === false), not a thrown error.
      allow read: if isStaff()
        || (isActive() && (resource == null || resource.data.candidateId == request.auth.uid));
      allow create, update: if isActive()
        && request.resource.data.candidateId == request.auth.uid
        && request.resource.data.applicationId == applicationId;
      allow delete: if false;
    }

    match /Interviews/{interviewId} {
      // The candidate read below is deliberately scoped to the parent
      // document only. Before G6, panel scores lived in a `scores` array on
      // this same document, which meant a candidate reading their own
      // Interview — allowed here so they can see their schedule — also
      // received the full panel scores array over the API, even though no
      // UI screen ever rendered it. A subcollection is never returned by a
      // read of its parent, so moving scores there (below) closes that
      // exposure structurally, not just by omission in the UI. Do not move
      // scores back onto this document to "simplify" later — that reopens
      // exactly this hole.
      allow read: if isStaff()
        || (isActive() && resource.data.candidateId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if isAdmin();

      // Panel scores (0-100). Same shape as Applications/{id}/ratings: the
      // document id is the panelist's uid, so a panelist can only ever write
      // their own score, and the second reason to be a subcollection rather
      // than a transaction on the parent array is the read-exposure note
      // above.
      match /scores/{panelistId} {
        allow read: if isStaff();
        allow create, update: if isStaff()
          && request.auth.uid == panelistId
          && request.resource.data.panelistId == panelistId
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100;
        allow delete: if isStaff() && request.auth.uid == panelistId;
      }
    }

    match /Offers/{offerId} {
      allow read: if isStaff()
        || (isActive() && resource.data.candidateId == request.auth.uid);
      allow create: if isStaff();
      // Staff manage offers; a candidate may only flip their own 'sent'
      // offer to accepted/rejected (nothing else). respondedByCandidate is a
      // signal flag for the notifyOfferResponse Cloud Function (functions/
      // index.js) to tell a candidate's own response apart from a
      // staff-recorded one — the candidate must be able to set it in the
      // same write as the status change, not as a separate update.
      allow update: if isStaff()
        || (isActive()
            && resource.data.candidateId == request.auth.uid
            && resource.data.status == 'sent'
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'respondedByCandidate']));
      allow delete: if isAdmin();
    }

    match /ReferenceChecks/{checkId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // In-app notification log (also the outbox for a future email sender).
    // A non-staff client may only ever create a notification addressed to
    // itself: without this, any signed-in candidate could create a
    // Notifications doc with any userId and any email, which becomes an open
    // relay on the client's mail domain the moment a sender reads this
    // collection. createdById is checked too, not just userId, so the sender
    // can trust it as "who actually wrote this row" even though the isStaff()
    // branch below doesn't itself require userId == createdById.
    match /Notifications/{notificationId} {
      allow read: if isStaff()
        || (isActive() && resource.data.userId == request.auth.uid);
      allow create: if isStaff()
        || (isActive()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.createdById == request.auth.uid);
      allow update: if isStaff()
        || (isActive() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // Shared pre-screening question library.
    // Each question is its own document with a choices subcollection.
    match /QuestionBank/{questionId} {
      allow read: if isStaff();
      allow write: if isAdmin();

      // Choices for each question (Yes/No and Multiple Choice options with points).
      match /choices/{choiceId} {
        allow read: if isStaff();
        allow write: if isAdmin();
      }
    }

    // Skills taxonomy (candidate-matching spec §2.1) — admin-managed, same
    // shape as QuestionBank. As written, this is staff read / admin write
    // only; the candidate-facing typeahead pickers in step 2 (profile
    // skills) need their own read access and are not yet covered here —
    // flagged to the user rather than silently widened.
    match /Skills/{skillId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Email/interview/advert templates: staff use them, admins manage them.
    match /Templates/{templateId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Hiring workflows: staff read (the job builder offers them); admins manage.
    match /Workflows/{workflowId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Job alert subscriptions. The document id is the subscriber's uid.
    match /JobAlerts/{userId} {
      allow read: if isStaff() || (isActive() && request.auth.uid == userId);
      allow create, update, delete: if isActive() && request.auth.uid == userId;
    }

    // Audit trail. Append-only by design: an entry is created by the user who
    // performed the action, read by admins, and never changed or deleted. That
    // immutability is what makes it a trail rather than just a log.
    match /AuditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}