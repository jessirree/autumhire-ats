# Non-secret SMTP/mail configuration for Wave F0 (see docs/wave-f0-email-brief.md §3.3).
# Copy to functions/.env.<project-id> and fill in — the Firebase CLI loads
# that file automatically on deploy. SMTP_PASSWORD is NOT here and never
# goes in a file: it lives only in Secret Manager
# (firebase functions:secrets:set SMTP_PASSWORD).

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
APP_BASE_URL=
MAIL_ENABLED=
# MAIL_HOURLY_LIMIT=   still to come from TrueHost support
